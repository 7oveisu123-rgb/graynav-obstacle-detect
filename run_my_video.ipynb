
import argparse
import sys
from pathlib import Path

import cv2
import numpy as np
import torch
import torch.nn.functional as F

# Make training/ importable
ROOT = Path(__file__).resolve().parent
sys.path.insert(0, str(ROOT / "training"))

from models.graynav_unified_perception import build_random_unified_yolov8n  # noqa: E402

STEP_OR_DROP_IDX = 2      # from SURFACE_CLASSES = (ground, blocked, step_or_drop, unknown)
STAIR_EDGE_IDX = 20       # last channel of 21
INPUT_H = INPUT_W = 384
GRID = 48


def load_model(checkpoint_path: Path, device: str):
    model = build_random_unified_yolov8n()
    ckpt = torch.load(checkpoint_path, map_location="cpu")
    state = ckpt["model"] if isinstance(ckpt, dict) and "model" in ckpt else ckpt
    missing, unexpected = model.load_state_dict(state, strict=False)
    if missing:
        print(f"[warn] missing keys: {len(missing)} -> {missing[:5]}")
    if unexpected:
        print(f"[warn] unexpected keys: {len(unexpected)} -> {unexpected[:5]}")
    model.to(device).eval()
    return model


@torch.no_grad()
def infer_frame(model, frame_bgr, device):
    gray = cv2.cvtColor(frame_bgr, cv2.COLOR_BGR2GRAY)
    gray = cv2.resize(gray, (INPUT_W, INPUT_H))
    tensor = torch.from_numpy(gray).float().div(255.0).unsqueeze(0).unsqueeze(0).to(device)
    outputs = model(tensor)
    scene = outputs[-1]  # (1, 21, 48, 48)
    step_logit = scene[0, STEP_OR_DROP_IDX]
    edge_logit = scene[0, STAIR_EDGE_IDX]
    step_prob = torch.sigmoid(step_logit)
    edge_prob = torch.sigmoid(edge_logit)
    step_prob = F.interpolate(step_prob[None, None], size=(INPUT_H, INPUT_W),
                              mode="bilinear", align_corners=False)[0, 0]
    edge_prob = F.interpolate(edge_prob[None, None], size=(INPUT_H, INPUT_W),
                              mode="bilinear", align_corners=False)[0, 0]
    return step_prob.cpu().numpy(), edge_prob.cpu().numpy()


def overlay(frame_bgr, step_prob, edge_prob, step_thr=0.5, edge_thr=0.5):
    h, w = frame_bgr.shape[:2]
    step_mask = cv2.resize(step_prob, (w, h)) > step_thr
    edge_mask = cv2.resize(edge_prob, (w, h)) > edge_thr
    out = frame_bgr.copy()
    red = np.zeros_like(out)
    red[..., 2] = 255
    if step_mask.any():
        blended = cv2.addWeighted(out, 0.5, red, 0.5, 0)
        out[step_mask] = blended[step_mask]
    contours, _ = cv2.findContours(edge_mask.astype(np.uint8),
                                   cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
    cv2.drawContours(out, contours, -1, (0, 255, 255), 2)
    triggered = bool(step_mask.any() or edge_mask.any())
    label = "STEP/DROP DETECTED" if triggered else "clear"
    color = (0, 0, 255) if triggered else (0, 255, 0)
    cv2.putText(out, label, (10, 30), cv2.FONT_HERSHEY_SIMPLEX, 0.9, color, 2)
    return out, triggered


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--video", required=True)
    ap.add_argument("--output", required=True)
    ap.add_argument("--checkpoint", default="weights/graynav_unified_best_safety_epoch29.pt")
    ap.add_argument("--device", default="mps")
    ap.add_argument("--step-thr", type=float, default=0.5)
    ap.add_argument("--edge-thr", type=float, default=0.5)
    ap.add_argument("--max-frames", type=int, default=0)
    args = ap.parse_args()

    if args.device == "mps" and not torch.backends.mps.is_available():
        args.device = "cpu"
    print(f"[info] device: {args.device}")

    model = load_model(Path(args.checkpoint), args.device)

    cap = cv2.VideoCapture(args.video)
    if not cap.isOpened():
        raise SystemExit(f"cannot open {args.video}")
    fps = cap.get(cv2.CAP_PROP_FPS) or 30.0
    w = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))
    h = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))
    writer = cv2.VideoWriter(args.output, cv2.VideoWriter_fourcc(*"mp4v"), fps, (w, h))

    idx = 0
    triggered_frames = 0
    while True:
        ok, frame = cap.read()
        if not ok:
            break
        step_prob, edge_prob = infer_frame(model, frame, args.device)
        out, trig = overlay(frame, step_prob, edge_prob, args.step_thr, args.edge_thr)
        writer.write(out)
        if trig:
            triggered_frames += 1
            print(f"[frame {idx}] STEP/DROP detected")
        idx += 1
        if args.max_frames and idx >= args.max_frames:
            break
    cap.release()
    writer.release()
    print(f"[done] {idx} frames, {triggered_frames} triggered, saved to {args.output}")


if __name__ == "__main__":
    main()